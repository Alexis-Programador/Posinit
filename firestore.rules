
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // CUENTA PRINCIPAL DE POS INIT
    // =====================================================

    match /soporteLimites/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ultimaSolicitud','solicitudId'])
        && request.resource.data.ultimaSolicitud == request.time
        && request.resource.data.solicitudId is string
        && (!exists(/databases/$(database)/documents/soporteLimites/$(uid))
            || request.time >= resource.data.ultimaSolicitud + duration.value(24,'h'))
        && getAfter(/databases/$(database)/documents/soporteSolicitudes/$(request.resource.data.solicitudId)).data.uid == uid
        && getAfter(/databases/$(database)/documents/soporteSolicitudes/$(request.resource.data.solicitudId)).data.fecha == request.time;
      allow delete: if false;
    }
    match /soporteSolicitudes/{ticket} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid','nombre','correo','telefono','mensaje','fecha','estado'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.fecha == request.time
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 150
        && request.resource.data.correo is string && request.resource.data.correo.size() <= 254
        && request.resource.data.telefono is string && request.resource.data.telefono.size() >= 7 && request.resource.data.telefono.size() <= 30
        && request.resource.data.mensaje is string && request.resource.data.mensaje.size() >= 10 && request.resource.data.mensaje.size() <= 4000
        && getAfter(/databases/$(database)/documents/soporteLimites/$(request.auth.uid)).data.solicitudId == ticket
        && getAfter(/databases/$(database)/documents/soporteLimites/$(request.auth.uid)).data.ultimaSolicitud == request.time;
      allow update, delete: if false;
    }
    match /directorioEmpresas/{correo} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if request.auth != null
        && request.auth.token.get('email', '').lower() == correo
        && request.resource.data.keys().hasOnly(['ownerUid', 'empresa'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.empresa is string && request.resource.data.empresa.size() > 0;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
    match /usuarios/{uid} {
      function puede(apartado, accion) {
        let miembro = /databases/$(database)/documents/usuarios/$(uid)/trabajadores/$(request.auth.uid);
        return request.auth != null && exists(miembro) && get(miembro).data.activo == true
          && get(/databases/$(database)/documents/usuarios/$(uid)/roles/$(get(miembro).data.rolId)).data.get("ver", {}).get(apartado, false) == true
          && (accion == "ver" || get(/databases/$(database)/documents/usuarios/$(uid)/roles/$(get(miembro).data.rolId)).data.get("editar", {}).get(apartado, false) == true);
      }
      function miembroActivo() {
        return request.auth != null && get(/databases/$(database)/documents/usuarios/$(uid)/trabajadores/$(request.auth.uid)).data.activo == true;
      }
      match /beneficios/premium {
        allow read: if request.auth != null && (request.auth.uid == uid || miembroActivo());
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['colores']) && request.resource.data.colores is bool
          && request.resource.data.colores == getAfter(/databases/$(database)/documents/usuarios/$(uid)/configuracion/general).data.premiumColores;
      }
      match /perfilesPersonal/{actor} {
        allow get: if request.auth != null && (request.auth.uid == uid || (request.auth.uid == actor && miembroActivo()));
        allow list: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == actor && miembroActivo()
          && request.resource.data.keys().hasOnly(['nombre','telefono','nombreEmergencia','telefonoEmergencia'])
          && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 100
          && request.resource.data.telefono is string && request.resource.data.telefono.size() <= 30
          && request.resource.data.nombreEmergencia is string && request.resource.data.nombreEmergencia.size() <= 100
          && request.resource.data.telefonoEmergencia is string && request.resource.data.telefonoEmergencia.size() <= 30;
      }
      match /ofertas/{producto} {
        allow read: if request.auth != null && (request.auth.uid == uid || puede('ofertas','ver') || puede('productos','ver') || puede('inventario','ver') || puede('etiquetas','ver'));
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['productoId','precioOferta','activa','actualizadoEn'])
          && request.resource.data.productoId == producto && request.resource.data.activa is bool
          && request.resource.data.precioOferta is number && request.resource.data.precioOferta > 0
          && request.resource.data.precioOferta < get(/databases/$(database)/documents/usuarios/$(uid)/productos/$(producto)).data.precioVenta
          && request.resource.data.actualizadoEn == request.time;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
      match /roles/{rolId} {
        allow read: if request.auth != null && (request.auth.uid == uid ||
          (get(/databases/$(database)/documents/usuarios/$(uid)/trabajadores/$(request.auth.uid)).data.activo == true &&
           get(/databases/$(database)/documents/usuarios/$(uid)/trabajadores/$(request.auth.uid)).data.rolId == rolId));
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(["nombre", "ver", "editar"])
          && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0
          && request.resource.data.ver is map && request.resource.data.editar is map;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
      match /trabajadores/{empleado} {
        allow get: if request.auth != null && (request.auth.uid == uid || request.auth.uid == empleado);
        allow list: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(["uid", "nombre", "rolId", "activo"])
          && request.resource.data.uid == empleado && request.resource.data.nombre is string
          && request.resource.data.activo is bool
          && exists(/databases/$(database)/documents/usuarios/$(uid)/roles/$(request.resource.data.rolId));
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
      match /solicitudesPersonal/{empleado} {
        allow get: if request.auth != null && (request.auth.uid == uid || request.auth.uid == empleado);
        allow list: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == empleado && empleado != uid
          && request.resource.data.keys().hasOnly(["uid", "estado", "correoDueno", "empresa", "dispositivo", "fecha"])
          && request.resource.data.uid == empleado && request.resource.data.estado == "pendiente"
          && request.resource.data.dispositivo is string && request.resource.data.dispositivo.size() < 200
          && get(/databases/$(database)/documents/directorioEmpresas/$(request.resource.data.correoDueno)).data.ownerUid == uid
          && get(/databases/$(database)/documents/directorioEmpresas/$(request.resource.data.correoDueno)).data.empresa == request.resource.data.empresa;
        allow update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["estado"])
          && request.resource.data.estado in ["aceptada", "rechazada"];
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
      match /{apartado}/{documento} {
        allow read: if apartado in ["productos","inventario","proveedores","ventas","registrosMercancia","cortesCaja","retirosCaja","robos"]
          && puede(apartado, "ver");
        allow update: if apartado == "inventario" && puede("inventario", "editar")
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["stockActual","stockMinimo","fechaActualizacion"])
          && request.resource.data.stockActual is int && request.resource.data.stockActual >= 0
          && request.resource.data.stockMinimo is int && request.resource.data.stockMinimo >= 0;
        allow update: if apartado == "proveedores" && puede("proveedores", "editar")
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["nombre","empresa","telefono","codigoPais","fechaActualizacion"])
          && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0;
      }


      allow create: if request.auth != null
        && request.auth.uid == uid;

      allow read: if request.auth != null
        && request.auth.uid == uid;

      allow update: if request.auth != null
        && request.auth.uid == uid;

      allow delete: if false;

      // ===================================================
      // CÁMARA REMOTA: SESIONES TEMPORALES
      // ===================================================

      match /sesionesCamara/{sesionId} {

        function esPropietarioCamara() {
          return request.auth != null
            && request.auth.uid == uid;
        }

        allow get: if esPropietarioCamara();

        allow list: if false;

        allow create: if esPropietarioCamara()
          && request.resource.data.keys().hasOnly([
            "ownerUid",
            "estado",
            "oferta",
            "respuesta",
            "creadoEn",
            "venceEn"
          ])
          && request.resource.data.keys().hasAll([
            "ownerUid",
            "estado",
            "oferta",
            "respuesta",
            "creadoEn",
            "venceEn"
          ])
          && request.resource.data.ownerUid == uid
          && request.resource.data.estado == "esperando"
          && request.resource.data.oferta is map
          && request.resource.data.oferta.type == "offer"
          && request.resource.data.oferta.sdp is string
          && request.resource.data.respuesta == null
          && request.resource.data.creadoEn == request.time
          && request.resource.data.venceEn is number
          && request.resource.data.venceEn > request.time.toMillis()
          && request.resource.data.venceEn
             <= request.time.toMillis() + 300000;

        allow update: if esPropietarioCamara()
          && resource.data.ownerUid == uid
          && resource.data.estado == "esperando"
          && resource.data.venceEn > request.time.toMillis()
          && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly([
               "respuesta",
               "estado"
             ])
          && request.resource.data.estado == "conectando"
          && request.resource.data.respuesta is map
          && request.resource.data.respuesta.type == "answer"
          && request.resource.data.respuesta.sdp is string;

        allow delete: if esPropietarioCamara();
      }

      // ===================================================
      // PRODUCTOS
      // ===================================================

      match /robos/{registro} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.propietarioUid == uid && request.resource.data.unidades is int
          && request.resource.data.unidades > 0
          && request.resource.data.stockResultante >= 0
          && request.resource.data.stockAnterior - request.resource.data.unidades == request.resource.data.stockResultante;
      }
      match /avisosMoviles/{aviso} {
        allow read: if request.auth != null && request.auth.uid == uid;
      }
      match /dispositivosMoviles/{dispositivo} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(["token"])
          && request.resource.data.token is string && request.resource.data.token.size() < 4096;
      }

      function revisionCatalogo() {
        let ruta = /databases/$(database)/documents/usuarios/$(uid)/_control/catalogo;
        return exists(ruta) ? get(ruta).data.get('revision', 0) : 0;
      }
      function catalogoActualizado() {
        let ruta = /databases/$(database)/documents/usuarios/$(uid)/_control/catalogo;
        return getAfter(ruta).data.revision == revisionCatalogo() + 1;
      }
      match /_control/catalogo {
        allow read: if request.auth != null && (request.auth.uid == uid || puede("productos", "editar"));
        allow create: if request.auth != null && (request.auth.uid == uid || puede("productos", "editar"))
          && request.resource.data.keys().hasOnly(['revision', 'fechaActualizacion', 'propietarioUid'])
          && request.resource.data.propietarioUid == uid && request.resource.data.revision == 1;
        allow update: if request.auth != null && (request.auth.uid == uid || puede("productos", "editar"))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revision', 'fechaActualizacion', 'propietarioUid'])
          && request.resource.data.propietarioUid == uid
          && request.resource.data.revision == resource.data.get('revision', 0) + 1;
      }

      match /productos/{productoId} {

        allow read: if request.auth != null
          && (request.auth.uid == uid || puede("productos", "editar") || puede("inventario", "ver") || puede("etiquetas", "ver") || puede("ofertas", "ver"));

        function productoValido() {
          let p = request.resource.data;
          return p.propietarioUid == uid && p.id is int && string(p.id) == productoId
            && p.nombre is string && p.nombre.size() > 0
            && p.codigoBarras is string && p.codigoBarras.size() > 0
            && p.categoria is string && p.categoria.size() > 0
            && p.precioVenta is number && p.precioVenta >= 0
            && catalogoActualizado();
        }
        allow create: if request.auth != null && (request.auth.uid == uid || puede("productos", "editar")) && productoValido()
          && getAfter(/databases/$(database)/documents/usuarios/$(uid)/inventario/$(productoId)).data.propietarioUid == uid;
        allow update: if request.auth != null && (request.auth.uid == uid || puede("productos", "editar"))
          && resource.data.propietarioUid == uid && productoValido();

        allow delete: if request.auth != null
          && (request.auth.uid == uid || puede("productos", "editar"))
          && resource.data.propietarioUid
             == request.auth.uid;
      }

      // ===================================================
      // INVENTARIO
      // ===================================================

      match /inventario/{productoId} {
        allow create: if puede("productos", "editar")
          && request.resource.data.keys().hasOnly(["productoId","stockActual","stockMinimo","propietarioUid","fechaActualizacion"])
          && request.resource.data.propietarioUid == uid
          && string(request.resource.data.productoId) == productoId
          && request.resource.data.stockActual == 0 && request.resource.data.stockMinimo == 0
          && getAfter(/databases/$(database)/documents/usuarios/$(uid)/productos/$(productoId)).data.propietarioUid == uid;

        allow read: if request.auth != null
          && request.auth.uid == uid;

        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.propietarioUid
             == request.auth.uid;

        allow update: if request.auth != null
          && request.auth.uid == uid
          && resource.data.propietarioUid
             == request.auth.uid
          && request.resource.data.propietarioUid
             == request.auth.uid;

        allow delete: if request.auth != null
          && request.auth.uid == uid
          && resource.data.propietarioUid
             == request.auth.uid;
      }

      // ===================================================
      // PROVEEDORES
      // ===================================================

      match /proveedores/{proveedorId} {

        allow read: if request.auth != null
          && request.auth.uid == uid;

        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.propietarioUid
             == request.auth.uid;

        allow update: if request.auth != null
          && request.auth.uid == uid
          && resource.data.propietarioUid
             == request.auth.uid
          && request.resource.data.propietarioUid
             == request.auth.uid;

        allow delete: if request.auth != null
          && request.auth.uid == uid
          && resource.data.propietarioUid
             == request.auth.uid;
      }

      // ===================================================
      // REGISTROS DE MERCANCÍA
      // ===================================================

      match /registrosMercancia/{registroId} {

        allow read: if request.auth != null
          && request.auth.uid == uid;

        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.propietarioUid
             == request.auth.uid;

        allow update: if request.auth != null
          && request.auth.uid == uid
          && resource.data.propietarioUid
             == request.auth.uid
          && request.resource.data.propietarioUid
             == request.auth.uid;

        allow delete: if request.auth != null
          && request.auth.uid == uid
          && resource.data.propietarioUid
             == request.auth.uid;
      }

      // ===================================================
      // USUARIOS / CAJEROS
      // ===================================================

      match /usuariosSistema/{usuarioId} {

        allow read: if request.auth != null
          && request.auth.uid == uid;

        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.propietarioUid
             == request.auth.uid;

        allow update: if request.auth != null
          && request.auth.uid == uid
          && resource.data.propietarioUid
             == request.auth.uid
          && request.resource.data.propietarioUid
             == request.auth.uid;

        allow delete: if request.auth != null
          && request.auth.uid == uid
          && resource.data.propietarioUid
             == request.auth.uid;
      }

      // ===================================================
      // VENTAS
      // ===================================================

      match /ventas/{ventaId} {

        allow read: if request.auth != null
          && request.auth.uid == uid;

        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.propietarioUid
             == request.auth.uid;

        allow update: if false;

        allow delete: if false;
      }

      // ===================================================
      // CORTES DE CAJA
      // ===================================================

      match /cortesCaja/{corteId} {

        allow read: if request.auth != null
          && request.auth.uid == uid;

        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.propietarioUid
             == request.auth.uid;

        allow update: if request.auth != null
          && request.auth.uid == uid
          && resource.data.propietarioUid
             == request.auth.uid
          && request.resource.data.propietarioUid
             == request.auth.uid;

        allow delete: if request.auth != null
          && request.auth.uid == uid
          && resource.data.propietarioUid
             == request.auth.uid;
      }

      // ===================================================
      // CIERRES DE SESIÓN DE CAJA
      // ===================================================

      match /cierresSesionCaja/{cierreId} {

        allow read: if request.auth != null
          && request.auth.uid == uid;

        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.propietarioUid == uid
          && request.resource.data.origen == "web"
          && request.resource.data.estado in [
            "pendiente_revision",
            "sin_efectivo_registrado"
          ]
          && request.resource.data.efectivoRegistrado is number
          && request.resource.data.efectivoRegistrado >= 0;

        allow update, delete: if false;
      }

      // ===================================================
      // RETIROS DE CAJA
      // ===================================================

      match /retirosCaja/{retiroId} {

        allow read: if request.auth != null
          && request.auth.uid == uid;

        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.propietarioUid
             == request.auth.uid;

        allow update: if request.auth != null
          && request.auth.uid == uid
          && resource.data.propietarioUid
             == request.auth.uid
          && request.resource.data.propietarioUid
             == request.auth.uid;

        allow delete: if request.auth != null
          && request.auth.uid == uid
          && resource.data.propietarioUid
             == request.auth.uid;
      }

      // ===================================================
      // CONFIGURACIÓN / AJUSTES
      // ===================================================

      match /configuracion/{configId} {

        allow read: if request.auth != null
          && request.auth.uid == uid;

        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.propietarioUid
             == request.auth.uid;

        allow update: if request.auth != null
          && request.auth.uid == uid
          && resource.data.propietarioUid
             == request.auth.uid
          && request.resource.data.propietarioUid
             == request.auth.uid;

        allow delete: if request.auth != null
          && request.auth.uid == uid
          && resource.data.propietarioUid
             == request.auth.uid;
      }
    }

    // =====================================================
    // PIN BÁSICO DE CAJEROS - FIREBASE SPARK
    // =====================================================

    match /posPinBasico/{ownerUid}/cajeros/{usuarioId} {

      function esPropietario() {
        return request.auth != null
          && request.auth.uid == ownerUid;
      }

      function cajeroExisteYActivo() {
        return exists(
          /databases/$(database)/documents/usuarios/$(ownerUid)/usuariosSistema/$(usuarioId)
        )
        && get(
          /databases/$(database)/documents/usuarios/$(ownerUid)/usuariosSistema/$(usuarioId)
        ).data.activo != false;
      }

      allow read: if esPropietario();

      allow create: if esPropietario()
        && cajeroExisteYActivo()
        && request.resource.data.keys().hasOnly([
          "sal",
          "hash",
          "creadoEn",
          "intentosFallidos",
          "bloqueado",
          "historial"
        ])
        && request.resource.data.sal is string
        && request.resource.data.hash is string
        && request.resource.data.creadoEn is number
        && request.resource.data.intentosFallidos == 0
        && request.resource.data.bloqueado == false
        && request.resource.data.historial is list
        && request.resource.data.historial.size() == 1
        && request.resource.data.historial[0]
           == request.resource.data.hash;

      allow update: if esPropietario()
        && cajeroExisteYActivo()
        && request.resource.data.diff(resource.data)
           .affectedKeys().hasOnly([
             "intentosFallidos",
             "bloqueado"
           ])
        && request.resource.data.intentosFallidos is int
        && request.resource.data.intentosFallidos >= 0
        && request.resource.data.intentosFallidos <= 4
        && request.resource.data.bloqueado is bool;

      allow delete: if false;
    }

    // =====================================================
    // PIN DE SEGURIDAD RESERVADO PARA SERVIDOR
    // =====================================================

    match /posPinSeguridad/{ownerUid}/cajeros/{usuarioId} {
      allow read, write: if false;
    }

    // =====================================================
    // POS INIT PAY - SPEI + STRIPE
    // =====================================================

    match /pagosPosInit/{pagoId} {

      function propietarioAutenticado() {
        return request.auth != null
          && request.auth.uid == resource.data.ownerUid;
      }

      function stripeVerificado() {
        return resource.data.keys().hasAll([
          "stripeConfirmacion"
        ])
        && resource.data.stripeConfirmacion is map
        && resource.data.stripeConfirmacion.proveedor == "stripe"
        && resource.data.stripeConfirmacion.estado == "paid"
        && resource.data.stripeConfirmacion.moneda == "mxn"
        && resource.data.stripeConfirmacion.importeCentavos
           == int(resource.data.total * 100)
        && resource.data.stripeConfirmacion.sessionId is string
        && resource.data.stripeConfirmacion.sessionId.size() > 0;
      }

      // Consultar un pago por ID, sin listar todos.
      allow get: if true;
      allow list: if false;

      // ===================================================
      // CREAR SOLICITUD DE PAGO
      // ===================================================

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          "ownerUid",
          "total",
          "estado",
          "banco",
          "titular",
          "clabe",
          "productos",
          "creadoEn",
          "cobroMixtoId",
          "totalVenta",
          "metodo"
        ])
        && request.resource.data.keys().hasAll([
          "ownerUid",
          "total",
          "estado",
          "productos",
          "creadoEn"
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.estado == "pendiente"
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && (
          (
            !request.resource.data.keys().hasAny([
              "cobroMixtoId",
              "totalVenta"
            ])
          )
          ||
          (
            request.resource.data.keys().hasAll([
              "cobroMixtoId",
              "totalVenta"
            ])
            && request.resource.data.cobroMixtoId is string
            && request.resource.data.cobroMixtoId.matches(
              '^[A-Za-z0-9_-]{15,80}$'
            )
            && request.resource.data.totalVenta is number
            && request.resource.data.totalVenta
               >= request.resource.data.total
            && request.resource.data.total >= 10
          )
        )
        && (
          (
            request.resource.data.keys().hasAll(["metodo"])
            && request.resource.data.metodo == "tarjeta"
            && !request.resource.data.keys().hasAny([
              "banco",
              "titular",
              "clabe"
            ])
            && request.resource.data.total >= 10
          )
          ||
          (
            !request.resource.data.keys().hasAny(["metodo"])
            && request.resource.data.keys().hasAll([
              "banco",
              "titular",
              "clabe"
            ])
            && request.resource.data.banco is string
            && request.resource.data.titular is string
            && request.resource.data.clabe is string
            && request.resource.data.clabe.matches(
              '^[0-9]{18}$'
            )
          )
        )
        && request.resource.data.productos is list
        && request.resource.data.creadoEn == request.time;

      // ===================================================
      // CONFIRMAR PAGO SPEI O STRIPE
      // ===================================================

      allow update: if propietarioAutenticado()

        && resource.data.estado == "pendiente"
        && request.resource.data.estado == "confirmado"

        && request.resource.data.diff(resource.data)
           .affectedKeys().hasOnly([
             "estado",
             "ventaId",
             "fechaConfirmacion",
             "ticket"
           ])

        && request.resource.data.keys().hasAll([
          "ventaId",
          "fechaConfirmacion",
          "ticket"
        ])

        && request.resource.data.ventaId is string
        && request.resource.data.ventaId.size() > 0

        && request.resource.data.fechaConfirmacion == request.time

        && request.resource.data.ticket is map

        && request.resource.data.ticket.folio
           == request.resource.data.ventaId

        && (
          (
            !resource.data.keys().hasAny(["cobroMixtoId"])
            && request.resource.data.ticket.total
               == resource.data.total
          )
          ||
          (
            resource.data.keys().hasAll([
              "cobroMixtoId",
              "totalVenta"
            ])
            && request.resource.data.ticket.metodoPago
               == "mixto"
            && request.resource.data.ticket.total
               == resource.data.totalVenta
            && request.resource.data.ticket.cobroMixtoId
               == resource.data.cobroMixtoId
          )
        )

        && request.resource.data.ticket.productos is list

        && (
          (
            request.resource.data.ticket.metodoPago
               == "transferencia"
            && !resource.data.keys().hasAny([
              "stripeConfirmacion",
              "metodo"
            ])
          )
          ||
          (
            (
              request.resource.data.ticket.metodoPago
                 == "tarjeta"
              ||
              (
                request.resource.data.ticket.metodoPago
                   == "mixto"
                && resource.data.keys().hasAll([
                  "cobroMixtoId",
                  "totalVenta"
                ])
              )
            )
            && resource.data.keys().hasAll(["metodo"])
            && resource.data.metodo == "tarjeta"
            && stripeVerificado()
          )
        );

      allow delete: if false;
    }

    // =====================================================
    // TODO LO DEMÁS BLOQUEADO
    // =====================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

